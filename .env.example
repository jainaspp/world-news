# Copy to .env for local server commands. Never commit the filled-in file.
# The browser does not read these values.

# Optional. Without them, /api/news still loads public RSS feeds.
# With them, /api/crawl stores a backup copy. Run the SQL migration first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for /api/crawl and for Vercel Cron. No default.
CRON_SECRET=

# Optional public site URL used in share links. Not a secret.
VITE_SITE_URL=https://world-news.xyz

# Optional AdSense slot IDs. Leave empty to render no ad boxes.
# Auto ads can still run from the loader in index.html.
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_FEED=

# Optional. Defaults to ca-pub-8392975944327076, which must match index.html.
VITE_GOOGLE_AD_CLIENT=
