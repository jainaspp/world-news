# Copy to .env for local server commands. Never commit the filled-in file.
# The browser does not read these values.

# Optional. Without them, /api/news still loads public RSS feeds.
# With them, /api/crawl stores a backup copy. Run the SQL migration first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for /api/crawl and for Vercel Cron. No default.
CRON_SECRET=

# Cloudflare Pages only. Header x-generate-secret for POST /api/generate. No default.
# GENERATE_SECRET=

# Cloudflare Pages only. Leave unset until world-news.xyz is the live custom domain.
# true sends a 301 from *.pages.dev to https://world-news.xyz. Previews stay on pages.dev while this is empty.
# REDIRECT_PAGES_DEV=

# Optional public site URL used in share links. Not a secret.
VITE_SITE_URL=https://world-news.xyz

# Optional AdSense slot IDs. Leave empty to keep the grey「支持世界頭條」placeholder
# (no <ins>). Auto ads can still run from the loader in index.html.
# Homepage (Vite build): VITE_AD_SLOT_* are baked at build time.
# Column / Functions pages also read runtime Pages vars AD_SLOT_TOP / MID / BOTTOM.
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_FEED=
# AD_SLOT_TOP=
# AD_SLOT_MID=
# AD_SLOT_BOTTOM=

# Optional. Defaults to ca-pub-8392975944327076, which must match index.html.
VITE_GOOGLE_AD_CLIENT=
