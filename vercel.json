{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "world-news-tawny.vercel.app" }],
      "destination": "https://world-news.xyz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "world-news-tawny.vercel.app" }],
      "destination": "https://world-news.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/region/:code", "destination": "/index.html" },
    { "source": "/category/:slug", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/crawl", "schedule": "0 8 * * *" }
  ],
  "headers": [
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
